@tailwind base;
@tailwind components;
@tailwind utilities;
@tailwind variants;

html,
body {
	@apply h-full;
}

:root {
	--parallax-ambient-x: 0rem;
	--parallax-ambient-y: 0rem;
	--parallax-grid-x: 0rem;
	--parallax-grid-y: 0rem;
	--parallax-hero-x: 0rem;
	--parallax-hero-y: 0rem;
	--parallax-near-x: 0rem;
	--parallax-near-y: 0rem;
	--parallax-mid-x: 0rem;
	--parallax-mid-y: 0rem;
	--parallax-far-x: 0rem;
	--parallax-far-y: 0rem;
	--parallax-orbit-x: 0rem;
	--parallax-orbit-y: 0rem;
	--parallax-bloom-x: 0rem;
	--glass-fill: rgba(34, 34, 34, 0.46);
	--glass-fill-strong: rgba(28, 28, 28, 0.68);
	--glass-border: rgba(255, 255, 255, 0.13);
	--glass-border-strong: rgba(255, 255, 255, 0.22);
	--glass-highlight: rgba(255, 255, 255, 0.34);
	--glass-shadow: rgba(0, 0, 0, 0.48);
	--motion-ease: cubic-bezier(0.22, 1, 0.36, 1);
	color-scheme: dark;
}

body {
	overflow-x: hidden;
	background:
		radial-gradient(circle at 50% -10%, rgba(255, 255, 255, 0.08), transparent 32rem),
		linear-gradient(180deg, #111 0%, #070707 58%, #0d0d0d 100%);
	text-rendering: geometricPrecision;
}

@keyframes fade-in {
	from {
		opacity: 0;
	}
}

@keyframes fade-out {
	to {
		opacity: 0;
	}
}

@keyframes slide-from-right {
	from {
		transform: translateX(30px);
	}
}

@keyframes slide-to-left {
	to {
		transform: translateX(-30px);
	}
}

@keyframes ambient-drift {
	0%,
	100% {
		transform: translate3d(0, 0, 0) scale(1);
	}
	50% {
		transform: translate3d(2.5rem, -1.5rem, 0) scale(1.08);
	}
}

@keyframes soft-breathe {
	0%,
	100% {
		opacity: 0.52;
		transform: translate3d(0, 0, 0) scale(1);
	}
	50% {
		opacity: 0.78;
		transform: translate3d(0, -0.55rem, 0) scale(1.015);
	}
}

@keyframes scan-line {
	0% {
		transform: translateX(-35%);
		opacity: 0;
	}
	20%,
	70% {
		opacity: 0.38;
	}
	100% {
		transform: translateX(135%);
		opacity: 0;
	}
}

@keyframes hud-float {
	0%,
	100% {
		transform: translate3d(0, 0, 0) rotate(0deg);
	}
	50% {
		transform: translate3d(0.75rem, -0.85rem, 0) rotate(1.5deg);
	}
}

.site-atmosphere {
	position: fixed;
	inset: 0;
	z-index: 0;
	pointer-events: none;
	overflow: hidden;
	isolation: isolate;
}

.site-atmosphere::after {
	content: '';
	position: absolute;
	inset: 0;
	background: linear-gradient(180deg, rgba(255, 255, 255, 0.015), rgba(0, 0, 0, 0.24));
	mix-blend-mode: normal;
}

.atmosphere-glow {
	position: absolute;
	width: min(34rem, 58vw);
	height: min(24rem, 46vw);
	border-radius: 44% 56% 62% 38% / 48% 41% 59% 52%;
	filter: blur(36px);
	opacity: 0.14;
	transform: translate3d(var(--parallax-ambient-x), var(--parallax-ambient-y), 0);
}

.glow-a {
	top: -18rem;
	left: -12rem;
	background: radial-gradient(
		circle,
		rgba(255, 255, 255, 0.24),
		rgba(92, 92, 92, 0.1) 48%,
		transparent 70%
	);
}

.atmosphere-grid {
	position: absolute;
	inset: -10%;
	opacity: 0.1;
	background-image:
		linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
		linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
	background-size: 84px 84px;
	mask-image: radial-gradient(circle at center, black 0%, transparent 68%);
	transform: perspective(900px) rotateX(62deg) translateY(7rem)
		translate3d(var(--parallax-grid-x), var(--parallax-grid-y), 0);
}

.atmosphere-noise {
	position: absolute;
	inset: 0;
	opacity: 0.045;
	background-image:
		linear-gradient(115deg, transparent 0 47%, rgba(255, 255, 255, 0.18) 49%, transparent 51%),
		radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.4) 0 1px, transparent 1px),
		radial-gradient(circle at 72% 68%, rgba(255, 255, 255, 0.35) 0 1px, transparent 1px);
	background-size:
		260px 260px,
		88px 92px,
		122px 118px;
}

.glass-depth,
.variant-glass-surface {
	position: relative;
	overflow: hidden;
	background:
		linear-gradient(
			145deg,
			rgba(255, 255, 255, 0.115),
			rgba(255, 255, 255, 0.025) 38%,
			rgba(0, 0, 0, 0.18)
		),
		var(--glass-fill) !important;
	border: 1px solid var(--glass-border) !important;
	box-shadow:
		0 14px 34px rgba(0, 0, 0, 0.42),
		inset 0 1px 0 rgba(255, 255, 255, 0.17),
		inset 0 -1px 0 rgba(255, 255, 255, 0.035);
	backdrop-filter: blur(8px) saturate(112%);
	-webkit-backdrop-filter: blur(8px) saturate(112%);
}

.glass-depth::before,
.variant-glass-surface::before {
	content: '';
	position: absolute;
	inset: 0;
	pointer-events: none;
	background:
		linear-gradient(100deg, transparent 0 12%, rgba(255, 255, 255, 0.16) 24%, transparent 42%),
		radial-gradient(circle at 18% 0%, rgba(255, 255, 255, 0.17), transparent 32%);
	opacity: 0.42;
}

.glass-depth > *,
.variant-glass-surface > * {
	position: relative;
	z-index: 1;
}

.glass-hover,
.hover-lift {
	transition:
		transform 0.45s var(--motion-ease),
		box-shadow 0.45s var(--motion-ease),
		border-color 0.45s ease,
		background 0.45s ease,
		filter 0.45s ease;
}

.glass-hover:hover,
.hover-lift:hover {
	transform: translate3d(0, -4px, 0);
	border-color: var(--glass-border-strong) !important;
	box-shadow:
		0 18px 42px rgba(0, 0, 0, 0.5),
		0 0 22px rgba(255, 255, 255, 0.045),
		inset 0 1px 0 rgba(255, 255, 255, 0.26);
	filter: brightness(1.04);
}

.reveal-soft {
	animation: soft-breathe 7s var(--motion-ease) infinite;
}

@media (prefers-reduced-motion: reduce) {
	*,
	*::before,
	*::after {
		animation-duration: 0.01ms !important;
		animation-iteration-count: 1 !important;
		scroll-behavior: auto !important;
		transition-duration: 0.01ms !important;
	}

	.atmosphere-glow,
	.atmosphere-grid {
		transform: none !important;
	}
}

:root::view-transition-old(root) {
	animation:
		90ms cubic-bezier(0.4, 0, 1, 1) both fade-out,
		300ms cubic-bezier(0.4, 0, 0.2, 1) both slide-to-left;
}

:root::view-transition-new(root) {
	animation:
		210ms cubic-bezier(0, 0, 0.2, 1) 90ms both fade-in,
		300ms cubic-bezier(0.4, 0, 0.2, 1) both slide-from-right;
}

.tooltip {
	position: relative;
}

.tooltip::before {
	@apply bg-surface-500;
	@apply border;
	@apply !border-gray-700;
	border-radius: 5px;
	color: #fff;
	content: attr(aria-label);
	display: inline-block;
	font-weight: normal;
	left: 50%;
	margin-top: calc(1px - 10px);
	opacity: 0;
	padding: 10px;
	pointer-events: none;
	position: absolute;
	top: 0;
	transform: translate(-50%, -90%);
	white-space: nowrap;
	width: auto;
	z-index: 2;
	transition: all 0.15s ease-out;
	@apply text-xs;
}

.tooltip:hover::before,
.tooltip:focus::before {
	opacity: 1;
	transform: translate(-50%, -100%);
}

.tooltip:after {
	content: '';
	height: 0;
	left: 50%;
	margin-left: -10px;
	margin-top: calc(-10px - 1px);
	opacity: 0;
	pointer-events: none;
	position: absolute;
	top: 0;
	transform: translate(0, 0);
	transition: all 0s ease-out 0s;
	width: 0;
	z-index: 1;
}

.tooltip:hover:after,
.tooltip:focus:after {
	opacity: 1;
	transition: all 0.15s ease-out 0.1s;
	transform: translate(0, 0);
}

.lt-ie9 .tooltip::before {
	margin-left: -110px;
	margin-top: -41px;
	min-width: 200px;
	text-align: center;
}
